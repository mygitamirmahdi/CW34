<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="inMemory" class="ir.maktabsharif.repository.InMemoryDB"/>

    <bean id="repository" class="ir.maktabsharif.repository.RepositoryImpl">
        <constructor-arg ref="inMemory"/>
    </bean>

    <bean id="bookService" class="ir.maktabsharif.service.BookServiceImpl">
        <constructor-arg ref="repository"/>
    </bean>

    <bean id="addBook" class="ir.maktabsharif.controller.AddBookController">
        <constructor-arg ref="bookService"/>
    </bean>

    <bean id="bookListController" class="ir.maktabsharif.controller.BookListController">
        <constructor-arg ref="bookService"/>
    </bean>

    <bean id="saveBookController" class="ir.maktabsharif.controller.SaveBookController">
        <constructor-arg ref="bookService"/>
    </bean>


    <bean class="org.springframework.web.servlet.handler.SimpleUrlHandlerMapping">
        <property name="mappings">
            <props>
                <prop key="/books/add">addBook</prop>
                <prop key="/books">bookListController</prop>
                <prop key="/books/save">saveBookController</prop>
            </props>
        </property>
    </bean>

    <!-- View Resolver -->
    <bean class="org.springframework.web.servlet.view.InternalResourceViewResolver">
        <property name="prefix" value="/WEB-INF/views/" />
        <property name="suffix" value=".jsp" />
    </bean>

</beans>